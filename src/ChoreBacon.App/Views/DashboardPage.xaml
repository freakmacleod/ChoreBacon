<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ChoreBacon.ViewModels"
             xmlns:progress="clr-namespace:ChoreBacon.Contracts.Progress;assembly=ChoreBacon.Contracts"
             xmlns:strings="clr-namespace:ChoreBacon.Resources.Strings"
             x:Class="ChoreBacon.Views.DashboardPage"
             x:DataType="vm:DashboardViewModel"
             Title="{Binding Title}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{x:Static strings:AppResources.Dashboard_Logout}" Command="{Binding LogoutCommand}" />
        <ToolbarItem Text="{x:Static strings:AppResources.Dashboard_DeleteAccount}" Command="{Binding DeleteAccountCommand}" Order="Secondary" />
    </ContentPage.ToolbarItems>

    <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy, Mode=OneWay}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="16">

                <!-- User header -->
                <Grid ColumnDefinitions="60,*" ColumnSpacing="12">
                    <Ellipse Grid.Column="0" WidthRequest="56" HeightRequest="56"
                             StrokeThickness="2" Stroke="{AppThemeBinding Light=#FF6B35, Dark=#FF8C5A}" />
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label Text="{Binding UserName}" FontSize="20" FontAttributes="Bold" />
                        <Label Text="{Binding Balance, StringFormat={x:Static strings:AppResources.Common_Points}}"
                               FontSize="14" TextColor="{AppThemeBinding Light=#FF6B35, Dark=#FF8C5A}" />
                        <Label Text="{Binding LifetimeEarned, StringFormat={x:Static strings:AppResources.Dashboard_LifetimeEarned}}"
                               FontSize="12" TextColor="Gray" />
                    </VerticalStackLayout>
                </Grid>

                <!-- Family (tap to open the family tab) -->
                <Border StrokeThickness="0" Padding="12" BackgroundColor="{AppThemeBinding Light=#FFF3E0, Dark=#2D1F0A}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToFamilyCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="{Binding FamilyText}" FontSize="13" />
                </Border>

                <!-- Error -->
                <Label Text="{Binding ErrorMessage}"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}"
                       TextColor="#F44336" FontSize="14" HorizontalTextAlignment="Center" />

                <!-- Stats cards -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border Grid.Column="0" StrokeThickness="0" Padding="16"
                            BackgroundColor="{AppThemeBinding Light=#FFF3E0, Dark=#2D1F0A}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="🔥" FontSize="28" HorizontalOptions="Center" />
                            <Label Text="{Binding StreakDays, StringFormat={x:Static strings:AppResources.Dashboard_StreakDays}}"
                                   FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" />
                            <Label Text="{x:Static strings:AppResources.Dashboard_StreakLabel}" FontSize="12"
                                   HorizontalOptions="Center" TextColor="Gray" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" StrokeThickness="0" Padding="16"
                            BackgroundColor="{AppThemeBinding Light=#E8F5E9, Dark=#0A2D0F}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="✅" FontSize="28" HorizontalOptions="Center" />
                            <Label HorizontalOptions="Center">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding ChoresDone}" FontAttributes="Bold" FontSize="22" />
                                        <Span Text="/" FontSize="16" TextColor="Gray" />
                                        <Span Text="{Binding ChoresTotal}" FontSize="16" TextColor="Gray" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label Text="{x:Static strings:AppResources.Dashboard_DoneLabel}" FontSize="12"
                                   HorizontalOptions="Center" TextColor="Gray" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Quick actions -->
                <Label Text="{x:Static strings:AppResources.Dashboard_QuickActions}" FontSize="18" FontAttributes="Bold" Margin="0,8,0,0" />

                <Grid ColumnDefinitions="*,*" RowDefinitions="*,*" ColumnSpacing="12" RowSpacing="12">
                    <Button Grid.Row="0" Grid.Column="0" Text="{x:Static strings:AppResources.Tab_Chores}"
                            Command="{Binding NavigateToChoresCommand}"
                            BackgroundColor="{AppThemeBinding Light=#FF6B35, Dark=#FF8C5A}"
                            TextColor="White" CornerRadius="10" HeightRequest="56" />
                    <Button Grid.Row="0" Grid.Column="1" Text="{x:Static strings:AppResources.Tab_Store}"
                            Command="{Binding NavigateToStoreCommand}"
                            BackgroundColor="{AppThemeBinding Light=#4CAF50, Dark=#388E3C}"
                            TextColor="White" CornerRadius="10" HeightRequest="56" />
                    <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{x:Static strings:AppResources.Tab_Achievements}"
                            Command="{Binding NavigateToAchievementsCommand}"
                            BackgroundColor="{AppThemeBinding Light=#9C27B0, Dark=#7B1FA2}"
                            TextColor="White" CornerRadius="10" HeightRequest="56" />
                </Grid>

                <!-- Recent achievements -->
                <Label Text="{x:Static strings:AppResources.Dashboard_RecentAchievements}" FontSize="18" FontAttributes="Bold" Margin="0,8,0,0" />

                <CollectionView ItemsSource="{Binding RecentAchievements}"
                                EmptyView="{x:Static strings:AppResources.Dashboard_NoAchievements}"
                                HeightRequest="120">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="12" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="progress:AchievementDto">
                            <Border WidthRequest="100" HeightRequest="100" Padding="8" StrokeThickness="0"
                                    BackgroundColor="{AppThemeBinding Light=#F3E5F5, Dark=#1A0A2D}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="4">
                                    <Label Text="{Binding Icon, Converter={StaticResource IconKeyConverter}}" FontSize="28" HorizontalOptions="Center" />
                                    <Label Text="{Binding Title}" FontSize="10" HorizontalOptions="Center"
                                           HorizontalTextAlignment="Center" MaxLines="2" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
