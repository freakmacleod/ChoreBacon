<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ChoreBacon.ViewModels"
             xmlns:strings="clr-namespace:ChoreBacon.Resources.Strings"
             x:Class="ChoreBacon.Views.FamilyCatalogPage"
             x:DataType="vm:FamilyCatalogViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Label Text="{Binding StatusMessage}"
                   IsVisible="{Binding StatusMessage, Converter={StaticResource StringToBoolConverter}}"
                   TextColor="{AppThemeBinding Light=#388E3C, Dark=#81C784}" HorizontalTextAlignment="Center" />
            <Label Text="{Binding ErrorMessage}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}"
                   TextColor="#F44336" HorizontalTextAlignment="Center" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <!-- Chores -->
            <Label Text="{x:Static strings:AppResources.Catalog_Chores}" FontSize="20" FontAttributes="Bold" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Chores}" Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:FamilyChoreItemViewModel">
                        <Border Padding="12" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <Label Text="{Binding Chore.Icon, Converter={StaticResource IconKeyConverter}}" FontSize="24" VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="{Binding Chore.Title}" FontAttributes="Bold" />
                                        <Label Text="{x:Static strings:AppResources.Catalog_FamilyOnly}" FontSize="11" TextColor="Gray" IsVisible="{Binding IsFamilyChore}" />
                                    </VerticalStackLayout>
                                    <HorizontalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center">
                                        <Label Text="{x:Static strings:AppResources.Catalog_Active}" FontSize="12" VerticalOptions="Center" />
                                        <Switch IsToggled="{Binding IsActive}" />
                                    </HorizontalStackLayout>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Entry Text="{Binding OverrideText}" Placeholder="{Binding OverrideLabel}" Keyboard="Numeric" />
                                    <Button Grid.Column="1" Text="{x:Static strings:AppResources.Common_Save}" FontSize="12" HeightRequest="36" CornerRadius="8"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FamilyCatalogViewModel}}, Path=SaveChoreCommand, x:DataType=vm:FamilyCatalogViewModel}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Border Padding="12" StrokeThickness="1" Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Label Text="{x:Static strings:AppResources.Catalog_NewChore}" FontAttributes="Bold" />
                    <Entry Text="{Binding NewChoreTitle}" Placeholder="{x:Static strings:AppResources.Catalog_NamePlaceholder}" MaxLength="100" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Entry Text="{Binding NewChorePoints}" Placeholder="{x:Static strings:AppResources.Catalog_PointsPlaceholder}" Keyboard="Numeric" />
                        <Picker Grid.Column="1" ItemsSource="{Binding Frequencies}" SelectedIndex="{Binding NewChoreFrequency}" />
                    </Grid>
                    <Button Text="{x:Static strings:AppResources.Catalog_Add}" Command="{Binding AddChoreCommand}"
                            BackgroundColor="{AppThemeBinding Light=#FF6B35, Dark=#FF8C5A}" TextColor="White" CornerRadius="8" />
                </VerticalStackLayout>
            </Border>

            <!-- Rewards -->
            <Label Text="{x:Static strings:AppResources.Catalog_Rewards}" FontSize="20" FontAttributes="Bold" Margin="0,12,0,0" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rewards}" Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:FamilyRewardItemViewModel">
                        <Border Padding="12" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <Label Text="{Binding Reward.Icon, Converter={StaticResource IconKeyConverter}}" FontSize="24" VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="{Binding Reward.Title}" FontAttributes="Bold" />
                                        <Label Text="{x:Static strings:AppResources.Catalog_FamilyOnly}" FontSize="11" TextColor="Gray" IsVisible="{Binding IsFamilyReward}" />
                                    </VerticalStackLayout>
                                    <HorizontalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center">
                                        <Label Text="{x:Static strings:AppResources.Catalog_Active}" FontSize="12" VerticalOptions="Center" />
                                        <Switch IsToggled="{Binding IsActive}" />
                                    </HorizontalStackLayout>
                                </Grid>
                                <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                                    <Entry Text="{Binding OverrideText}" Placeholder="{Binding OverrideLabel}" Keyboard="Numeric" />
                                    <Entry Grid.Column="1" Text="{Binding StockText}" Placeholder="{x:Static strings:AppResources.Catalog_Stock}" Keyboard="Numeric" />
                                    <Button Grid.Column="2" Text="{x:Static strings:AppResources.Common_Save}" FontSize="12" HeightRequest="36" CornerRadius="8"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FamilyCatalogViewModel}}, Path=SaveRewardCommand, x:DataType=vm:FamilyCatalogViewModel}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Border Padding="12" StrokeThickness="1" Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Label Text="{x:Static strings:AppResources.Catalog_NewReward}" FontAttributes="Bold" />
                    <Entry Text="{Binding NewRewardTitle}" Placeholder="{x:Static strings:AppResources.Catalog_NamePlaceholder}" MaxLength="100" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Entry Text="{Binding NewRewardCost}" Placeholder="{x:Static strings:AppResources.Catalog_CostPlaceholder}" Keyboard="Numeric" />
                        <Entry Grid.Column="1" Text="{Binding NewRewardStock}" Placeholder="{x:Static strings:AppResources.Catalog_Stock}" Keyboard="Numeric" />
                    </Grid>
                    <Button Text="{x:Static strings:AppResources.Catalog_Add}" Command="{Binding AddRewardCommand}"
                            BackgroundColor="{AppThemeBinding Light=#4CAF50, Dark=#388E3C}" TextColor="White" CornerRadius="8" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
