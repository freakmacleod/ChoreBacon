<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ChoreBacon.ViewModels"
             xmlns:strings="clr-namespace:ChoreBacon.Resources.Strings"
             x:Class="ChoreBacon.Views.ChoresPage"
             x:DataType="vm:ChoresViewModel"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Points header -->
        <Border Grid.Row="0" StrokeThickness="0" Padding="16,12"
                BackgroundColor="{AppThemeBinding Light=#FF6B35, Dark=#CC5522}">
            <Label Text="{Binding Balance, StringFormat={x:Static strings:AppResources.Chores_Balance}}"
                   FontSize="18" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" />
        </Border>

        <!-- Status and error -->
        <VerticalStackLayout Grid.Row="1" Padding="16,8" Spacing="4">
            <Label Text="{Binding StatusMessage}"
                   IsVisible="{Binding StatusMessage, Converter={StaticResource StringToBoolConverter}}"
                   TextColor="{AppThemeBinding Light=#388E3C, Dark=#81C784}"
                   FontSize="14" HorizontalTextAlignment="Center" />
            <Label Text="{Binding ErrorMessage}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}"
                   TextColor="#F44336" FontSize="14" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <!-- Chores list -->
        <RefreshView Grid.Row="2" Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy, Mode=OneWay}">
            <CollectionView ItemsSource="{Binding Chores}"
                            EmptyView="{x:Static strings:AppResources.Chores_Empty}"
                            Margin="0,8">
                <CollectionView.Header>
                    <VerticalStackLayout IsVisible="{Binding HasCombos}" Padding="16,0,16,8" Spacing="8">
                        <Label Text="{x:Static strings:AppResources.Combos_Title}" FontSize="18" FontAttributes="Bold" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Combos}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:ComboItemViewModel">
                                    <Border Padding="16" StrokeThickness="2"
                                            Stroke="{AppThemeBinding Light=#FFB74D, Dark=#E65100}"
                                            BackgroundColor="{AppThemeBinding Light=#FFF8E1, Dark=#2A2118}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                            <Label Grid.Column="0" Text="{Binding Combo.Icon, Converter={StaticResource IconKeyConverter}}"
                                                   FontSize="28" VerticalOptions="Start" />
                                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                <Label Text="{Binding Combo.Title}" FontSize="16" FontAttributes="Bold" />
                                                <Label Text="{x:Static strings:AppResources.Common_FamilyItem}" FontSize="11"
                                                       TextColor="{AppThemeBinding Light=#9C27B0, Dark=#CE93D8}" IsVisible="{Binding Combo.IsFamilyItem}" />
                                                <Label FontSize="13">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding BonusText}" FontAttributes="Bold"
                                                                  TextColor="{AppThemeBinding Light=#FF6B35, Dark=#FF8C5A}" />
                                                            <Span Text=" · " TextColor="Gray" />
                                                            <Span Text="{Binding PeriodText}" TextColor="Gray" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                                <Label Text="{Binding ChoresText}" FontSize="13" />
                                                <Label Text="{Binding ProgressText}" FontSize="13" FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light=#388E3C, Dark=#81C784}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </CollectionView.Header>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ChoreItemViewModel">
                        <Border Margin="16,4" Padding="16" StrokeThickness="0"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Label Grid.Column="0" Text="{Binding Chore.Icon, Converter={StaticResource IconKeyConverter}}"
                                       FontSize="28" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="{Binding Chore.Title}" FontSize="16" FontAttributes="Bold" />
                                    <Label Text="{x:Static strings:AppResources.Common_FamilyItem}" FontSize="11"
                                           TextColor="{AppThemeBinding Light=#9C27B0, Dark=#CE93D8}" IsVisible="{Binding Chore.IsFamilyItem}" />
                                    <Label Text="{Binding Chore.Description}" FontSize="13" TextColor="Gray" />
                                    <Label Text="{Binding DeadlineText}" IsVisible="{Binding IsTemporary}" FontSize="13" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#D84315, Dark=#FF8A65}" />
                                    <Label FontSize="13" TextColor="{AppThemeBinding Light=#FF6B35, Dark=#FF8C5A}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Chore.Points, StringFormat={x:Static strings:AppResources.Chores_Points}}" />
                                                <Span Text=" · " TextColor="Gray" />
                                                <Span Text="{Binding FrequencyText}" TextColor="Gray" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </VerticalStackLayout>
                                <Button Grid.Column="2"
                                        Text="{Binding ActionText}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChoresViewModel}}, Path=CompleteChoreCommand, x:DataType=vm:ChoresViewModel}"
                                        CommandParameter="{Binding .}"
                                        IsEnabled="{Binding IsCompleted, Converter={StaticResource InverseBoolConverter}}"
                                        BackgroundColor="{Binding IsCompleted, Converter={StaticResource BoolToCompletedColorConverter}}"
                                        TextColor="White"
                                        CornerRadius="8"
                                        WidthRequest="90"
                                        HeightRequest="40" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>
</ContentPage>
