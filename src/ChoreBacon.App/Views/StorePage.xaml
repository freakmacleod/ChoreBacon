<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ChoreBacon.ViewModels"
             xmlns:strings="clr-namespace:ChoreBacon.Resources.Strings"
             x:Class="ChoreBacon.Views.StorePage"
             x:DataType="vm:StoreViewModel"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Points header -->
        <Border Grid.Row="0" StrokeThickness="0" Padding="16,12"
                BackgroundColor="{AppThemeBinding Light=#4CAF50, Dark=#2E7D32}">
            <Label Text="{Binding Balance, StringFormat={x:Static strings:AppResources.Store_Balance}}"
                   FontSize="18" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" />
        </Border>

        <!-- Status and error -->
        <VerticalStackLayout Grid.Row="1" Padding="16,8" Spacing="4">
            <Label Text="{Binding StatusMessage}"
                   IsVisible="{Binding StatusMessage, Converter={StaticResource StringToBoolConverter}}"
                   TextColor="{AppThemeBinding Light=#1565C0, Dark=#64B5F6}"
                   FontSize="14" HorizontalTextAlignment="Center" />
            <Label Text="{Binding ErrorMessage}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}"
                   TextColor="#F44336" FontSize="14" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <!-- Rewards grid -->
        <RefreshView Grid.Row="2" Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy, Mode=OneWay}">
            <CollectionView ItemsSource="{Binding Rewards}"
                            EmptyView="{x:Static strings:AppResources.Store_Empty}"
                            Margin="8">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="8" VerticalItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:RewardItemViewModel">
                        <Border Padding="12" StrokeThickness="0"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{Binding Reward.Icon, Converter={StaticResource IconKeyConverter}}" FontSize="32" HorizontalOptions="Center" />
                                <Label Text="{Binding Reward.Title}" FontSize="15" FontAttributes="Bold"
                                       HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                                <Label Text="{x:Static strings:AppResources.Common_FamilyItem}" FontSize="11" HorizontalOptions="Center"
                                       TextColor="{AppThemeBinding Light=#9C27B0, Dark=#CE93D8}" IsVisible="{Binding Reward.IsFamilyItem}" />
                                <Label Text="{Binding Reward.Description}" FontSize="12" TextColor="Gray"
                                       HorizontalOptions="Center" HorizontalTextAlignment="Center" MaxLines="2" />
                                <Label Text="{Binding StockText}" FontSize="12" TextColor="Gray" HorizontalOptions="Center"
                                       IsVisible="{Binding StockText, Converter={StaticResource StringToBoolConverter}}" />
                                <Button Text="{Binding Reward.Cost, StringFormat={x:Static strings:AppResources.Store_Cost}}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:StoreViewModel}}, Path=RedeemRewardCommand, x:DataType=vm:StoreViewModel}"
                                        CommandParameter="{Binding .}"
                                        IsEnabled="{Binding CanRedeem}"
                                        BackgroundColor="{AppThemeBinding Light=#4CAF50, Dark=#388E3C}"
                                        TextColor="White"
                                        CornerRadius="8"
                                        HeightRequest="38"
                                        FontSize="14" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>
</ContentPage>
