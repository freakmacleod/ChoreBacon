<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ChoreBacon.ViewModels"
             xmlns:strings="clr-namespace:ChoreBacon.Resources.Strings"
             x:Class="ChoreBacon.Views.AchievementsPage"
             x:DataType="vm:AchievementsViewModel"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Progress header -->
        <Border Grid.Row="0" StrokeThickness="0" Padding="16,12"
                BackgroundColor="{AppThemeBinding Light=#9C27B0, Dark=#6A0080}">
            <Label FontSize="18" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center">
                <Label.Text>
                    <MultiBinding StringFormat="{x:Static strings:AppResources.Achievements_Progress}">
                        <Binding Path="UnlockedCount" />
                        <Binding Path="TotalCount" />
                    </MultiBinding>
                </Label.Text>
            </Label>
        </Border>

        <Label Grid.Row="1" Text="{Binding ErrorMessage}" Padding="16,8"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}"
               TextColor="#F44336" FontSize="14" HorizontalTextAlignment="Center" />

        <!-- Achievements list -->
        <RefreshView Grid.Row="2" Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy, Mode=OneWay}">
            <CollectionView ItemsSource="{Binding Achievements}"
                            EmptyView="{x:Static strings:AppResources.Achievements_Empty}"
                            Margin="0,8">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:AchievementItemViewModel">
                        <Border Margin="16,4" Padding="16" StrokeThickness="1"
                                Stroke="{Binding RarityColor}"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="56,*" ColumnSpacing="12">
                                <!-- Icon with lock overlay -->
                                <Grid Grid.Column="0" WidthRequest="56" HeightRequest="56">
                                    <Ellipse WidthRequest="56" HeightRequest="56"
                                             Fill="{Binding RarityColor}" Opacity="0.2" />
                                    <Label Text="{Binding Achievement.Icon, Converter={StaticResource IconKeyConverter}}"
                                           FontSize="28" HorizontalOptions="Center" VerticalOptions="Center" />
                                    <Label Text="🔒" FontSize="18"
                                           IsVisible="{Binding IsUnlocked, Converter={StaticResource InverseBoolConverter}}"
                                           HorizontalOptions="End" VerticalOptions="End" />
                                </Grid>
                                <!-- Details -->
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="{Binding Achievement.Title}"
                                           FontSize="16" FontAttributes="Bold"
                                           Opacity="{Binding IsUnlocked, Converter={StaticResource BoolToOpacityConverter}}" />
                                    <Label Text="{Binding Achievement.Description}"
                                           FontSize="13" TextColor="Gray" />
                                    <Label Text="{Binding Achievement.BonusPoints, StringFormat={x:Static strings:AppResources.Achievements_Bonus}}"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light=#FF6B35, Dark=#FF8C5A}"
                                           IsVisible="{Binding Achievement.BonusPoints, Converter={StaticResource IntToBoolConverter}}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
