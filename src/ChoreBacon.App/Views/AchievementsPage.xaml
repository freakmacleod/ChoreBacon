<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ChoreBacon.ViewModels"
             x:Class="ChoreBacon.Views.AchievementsPage"
             x:DataType="vm:AchievementsViewModel"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto,*">

        <!-- Progress Header -->
        <Frame Grid.Row="0" BackgroundColor="{AppThemeBinding Light=#9C27B0, Dark=#6A0080}"
               Padding="16,12" CornerRadius="0" BorderColor="Transparent">
            <Label FontSize="18" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="🏆 " />
                        <Span Text="{Binding UnlockedCount}" FontAttributes="Bold" />
                        <Span Text=" / " />
                        <Span Text="{Binding TotalCount}" />
                        <Span Text=" Achievements Unlocked" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
        </Frame>

        <!-- Achievements List -->
        <RefreshView Grid.Row="1" Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding Achievements}"
                            EmptyView="No achievements found."
                            Margin="0,8">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:AchievementItemViewModel">
                        <Frame Margin="16,4" Padding="16" CornerRadius="12"
                               BorderColor="{Binding RarityColor}"
                               BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                            <Grid ColumnDefinitions="56,*" ColumnSpacing="12">
                                <!-- Icon with lock overlay -->
                                <Grid Grid.Column="0" WidthRequest="56" HeightRequest="56">
                                    <Ellipse WidthRequest="56" HeightRequest="56"
                                             Fill="{Binding RarityColor}" Opacity="0.2" />
                                    <Label Text="{Binding Achievement.IconName}"
                                           FontSize="28" HorizontalOptions="Center" VerticalOptions="Center" />
                                    <Label Text="🔒" FontSize="18"
                                           IsVisible="{Binding IsUnlocked, Converter={StaticResource InverseBoolConverter}}"
                                           HorizontalOptions="End" VerticalOptions="End" />
                                </Grid>
                                <!-- Details -->
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="{Binding Achievement.Name}"
                                           FontSize="16" FontAttributes="Bold"
                                           Opacity="{Binding IsUnlocked, Converter={StaticResource BoolToOpacityConverter}}" />
                                    <Label Text="{Binding Achievement.Description}"
                                           FontSize="13" TextColor="Gray" />
                                    <Label Text="{Binding Achievement.BonusPoints, StringFormat='+{0} bonus pts'}"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light=#FF6B35, Dark=#FF8C5A}"
                                           IsVisible="{Binding Achievement.BonusPoints, Converter={StaticResource IntToBoolConverter}}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
