<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ChoreBacon.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ChoreBacon.Views"
    xmlns:strings="clr-namespace:ChoreBacon.Resources.Strings"
    Title="ChoreBacon"
    Shell.NavBarIsVisible="True">

    <!-- Login — not in tab bar -->
    <ShellContent x:Name="LoginShell"
                  ContentTemplate="{DataTemplate views:LoginPage}"
                  Route="login"
                  Shell.NavBarIsVisible="False" />

    <!-- Main Tab Bar (visible after login) -->
    <TabBar x:Name="MainTabBar" Route="main">

        <Tab Title="{x:Static strings:AppResources.Tab_Dashboard}" Icon="tab_dashboard.png">
            <ShellContent ContentTemplate="{DataTemplate views:DashboardPage}" Route="dashboard" />
        </Tab>

        <Tab Title="{x:Static strings:AppResources.Tab_Chores}" Icon="tab_chores.png">
            <ShellContent ContentTemplate="{DataTemplate views:ChoresPage}" Route="chores" />
        </Tab>

        <Tab Title="{x:Static strings:AppResources.Tab_Store}" Icon="tab_store.png">
            <ShellContent ContentTemplate="{DataTemplate views:StorePage}" Route="store" />
        </Tab>

        <Tab Title="{x:Static strings:AppResources.Tab_Achievements}" Icon="tab_achievements.png">
            <ShellContent ContentTemplate="{DataTemplate views:AchievementsPage}" Route="achievements" />
        </Tab>

    </TabBar>

</Shell>
