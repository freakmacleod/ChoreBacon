<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:ChoreBacon.Helpers"
             x:Class="ChoreBacon.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Value Converters -->
            <helpers:StringToBoolConverter x:Key="StringToBoolConverter" />
            <helpers:InverseBoolConverter x:Key="InverseBoolConverter" />
            <helpers:BoolToOpacityConverter x:Key="BoolToOpacityConverter" />
            <helpers:BoolToCompletedTextConverter x:Key="BoolToCompletedTextConverter" />
            <helpers:BoolToCompletedColorConverter x:Key="BoolToCompletedColorConverter" />
            <helpers:IntToBoolConverter x:Key="IntToBoolConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
