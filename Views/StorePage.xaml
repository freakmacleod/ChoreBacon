<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ChoreBacon.ViewModels"
             xmlns:models="clr-namespace:ChoreBacon.Models"
             x:Class="ChoreBacon.Views.StorePage"
             x:DataType="vm:StoreViewModel"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Points Header -->
        <Frame Grid.Row="0" BackgroundColor="{AppThemeBinding Light=#4CAF50, Dark=#2E7D32}"
               Padding="16,12" CornerRadius="0" BorderColor="Transparent">
            <Label Text="{Binding UserPoints, StringFormat='⭐ {0} Points Available'}"
                   FontSize="18" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" />
        </Frame>

        <!-- Status Message -->
        <Label Grid.Row="1"
               Text="{Binding StatusMessage}"
               IsVisible="{Binding StatusMessage, Converter={StaticResource StringToBoolConverter}}"
               Padding="16,8"
               TextColor="{AppThemeBinding Light=#1565C0, Dark=#64B5F6}"
               FontSize="14" HorizontalTextAlignment="Center" />

        <!-- Rewards Grid -->
        <RefreshView Grid.Row="2" Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding Rewards}"
                            EmptyView="No rewards available yet."
                            Margin="8">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="8" VerticalItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:RewardItem">
                        <Frame Padding="12" CornerRadius="12" BorderColor="Transparent"
                               BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{Binding IconName}" FontSize="32" HorizontalOptions="Center" />
                                <Label Text="{Binding Name}" FontSize="15" FontAttributes="Bold"
                                       HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                                <Label Text="{Binding Description}" FontSize="12" TextColor="Gray"
                                       HorizontalOptions="Center" HorizontalTextAlignment="Center" MaxLines="2" />
                                <Button Text="{Binding PointCost, StringFormat='⭐ {0} pts'}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:StoreViewModel}}, Path=RedeemRewardCommand}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="{AppThemeBinding Light=#4CAF50, Dark=#388E3C}"
                                        TextColor="White"
                                        CornerRadius="8"
                                        HeightRequest="38"
                                        FontSize="14" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>
</ContentPage>
