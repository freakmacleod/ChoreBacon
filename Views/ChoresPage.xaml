<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ChoreBacon.ViewModels"
             x:Class="ChoreBacon.Views.ChoresPage"
             x:DataType="vm:ChoresViewModel"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Points Header -->
        <Frame Grid.Row="0" BackgroundColor="{AppThemeBinding Light=#FF6B35, Dark=#CC5522}"
               Padding="16,12" CornerRadius="0" BorderColor="Transparent">
            <Label Text="{Binding UserPoints, StringFormat='⭐ {0} Points'}"
                   FontSize="18" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" />
        </Frame>

        <!-- Status Message -->
        <Label Grid.Row="1"
               Text="{Binding StatusMessage}"
               IsVisible="{Binding StatusMessage, Converter={StaticResource StringToBoolConverter}}"
               Padding="16,8"
               TextColor="{AppThemeBinding Light=#388E3C, Dark=#81C784}"
               FontSize="14" HorizontalTextAlignment="Center" />

        <!-- Chores List -->
        <RefreshView Grid.Row="2" Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding Chores}"
                            EmptyView="No chores available. Add some to get started!"
                            Margin="0,8">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ChoreItemViewModel">
                        <SwipeView>
                            <SwipeView.Content>
                                <Frame Margin="16,4" Padding="16" CornerRadius="12" BorderColor="Transparent"
                                       BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="{Binding Chore.Name}" FontSize="16" FontAttributes="Bold" />
                                            <Label Text="{Binding Chore.Description}" FontSize="13" TextColor="Gray" />
                                            <Label Text="{Binding Chore.PointValue, StringFormat='⭐ {0} pts'}"
                                                   FontSize="13"
                                                   TextColor="{AppThemeBinding Light=#FF6B35, Dark=#FF8C5A}" />
                                        </VerticalStackLayout>
                                        <Button Grid.Column="1"
                                                Text="{Binding IsCompleted, Converter={StaticResource BoolToCompletedTextConverter}}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChoresViewModel}}, Path=CompleteChoreCommand}"
                                                CommandParameter="{Binding .}"
                                                IsEnabled="{Binding IsCompleted, Converter={StaticResource InverseBoolConverter}}"
                                                BackgroundColor="{Binding IsCompleted, Converter={StaticResource BoolToCompletedColorConverter}}"
                                                TextColor="White"
                                                CornerRadius="8"
                                                WidthRequest="90"
                                                HeightRequest="40" />
                                    </Grid>
                                </Frame>
                            </SwipeView.Content>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>
</ContentPage>
