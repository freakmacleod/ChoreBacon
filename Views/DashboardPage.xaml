<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ChoreBacon.ViewModels"
             xmlns:models="clr-namespace:ChoreBacon.Models"
             x:Class="ChoreBacon.Views.DashboardPage"
             x:DataType="vm:DashboardViewModel"
             Title="{Binding Title}">

    <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="16">

                <!-- User Header -->
                <Grid ColumnDefinitions="60,*" ColumnSpacing="12">
                    <Ellipse Grid.Column="0" WidthRequest="56" HeightRequest="56"
                             StrokeThickness="2" Stroke="{AppThemeBinding Light=#FF6B35, Dark=#FF8C5A}" />
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label Text="{Binding UserName}" FontSize="20" FontAttributes="Bold" />
                        <Label Text="{Binding TotalPoints, StringFormat='{0} points'}"
                               FontSize="14" TextColor="{AppThemeBinding Light=#FF6B35, Dark=#FF8C5A}" />
                    </VerticalStackLayout>
                </Grid>

                <!-- Stats Cards -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <!-- Streak Card -->
                    <Frame Grid.Column="0" BackgroundColor="{AppThemeBinding Light=#FFF3E0, Dark=#2D1F0A}"
                           CornerRadius="12" Padding="16" BorderColor="Transparent">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="🔥" FontSize="28" HorizontalOptions="Center" />
                            <Label Text="{Binding StreakDays, StringFormat='{0} days'}"
                                   FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" />
                            <Label Text="Current Streak" FontSize="12"
                                   HorizontalOptions="Center" TextColor="Gray" />
                        </VerticalStackLayout>
                    </Frame>
                    <!-- Chores Today Card -->
                    <Frame Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#E8F5E9, Dark=#0A2D0F}"
                           CornerRadius="12" Padding="16" BorderColor="Transparent">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="✅" FontSize="28" HorizontalOptions="Center" />
                            <Label Text="{Binding ChoresCompletedToday, StringFormat='{0}/{1}'}"
                                   FontSize="22" FontAttributes="Bold" HorizontalOptions="Center">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding ChoresCompletedToday}" FontAttributes="Bold" FontSize="22" />
                                        <Span Text="/" FontSize="16" TextColor="Gray" />
                                        <Span Text="{Binding TotalChores}" FontSize="16" TextColor="Gray" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label Text="Done Today" FontSize="12"
                                   HorizontalOptions="Center" TextColor="Gray" />
                        </VerticalStackLayout>
                    </Frame>
                </Grid>

                <!-- Quick Nav Buttons -->
                <Label Text="Quick Actions" FontSize="18" FontAttributes="Bold" Margin="0,8,0,0" />

                <Grid ColumnDefinitions="*,*" RowDefinitions="*,*" ColumnSpacing="12" RowSpacing="12">
                    <Button Grid.Row="0" Grid.Column="0" Text="Chores"
                            Command="{Binding NavigateToChoresCommand}"
                            BackgroundColor="{AppThemeBinding Light=#FF6B35, Dark=#FF8C5A}"
                            TextColor="White" CornerRadius="10" HeightRequest="56" />
                    <Button Grid.Row="0" Grid.Column="1" Text="Store"
                            Command="{Binding NavigateToStoreCommand}"
                            BackgroundColor="{AppThemeBinding Light=#4CAF50, Dark=#388E3C}"
                            TextColor="White" CornerRadius="10" HeightRequest="56" />
                    <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="Achievements"
                            Command="{Binding NavigateToAchievementsCommand}"
                            BackgroundColor="{AppThemeBinding Light=#9C27B0, Dark=#7B1FA2}"
                            TextColor="White" CornerRadius="10" HeightRequest="56" />
                </Grid>

                <!-- Recent Achievements -->
                <Label Text="Recent Achievements" FontSize="18" FontAttributes="Bold" Margin="0,8,0,0" />

                <CollectionView ItemsSource="{Binding RecentAchievements}"
                                EmptyView="No achievements yet. Complete chores to earn them!"
                                HeightRequest="120">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="12" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Achievement">
                            <Frame WidthRequest="100" HeightRequest="100" CornerRadius="12"
                                   Padding="8" BorderColor="Transparent"
                                   BackgroundColor="{AppThemeBinding Light=#F3E5F5, Dark=#1A0A2D}">
                                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="4">
                                    <Label Text="{Binding IconName}" FontSize="28" HorizontalOptions="Center" />
                                    <Label Text="{Binding Name}" FontSize="10" HorizontalOptions="Center"
                                           HorizontalTextAlignment="Center" MaxLines="2" />
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
